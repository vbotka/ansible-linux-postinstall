---

lp_repos:
  # Canonical / Ubuntu official repository
- name: 'ubuntu-archive'
  uris: 'http://archive.ubuntu.com/ubuntu/'
  suites: ['noble', 'noble-updates', 'noble-backports']
  components: ['main', 'restricted', 'universe', 'multiverse']
  types: ['deb']
  signed_by: '/usr/share/keyrings/ubuntu-archive-keyring.gpg'

  # Ansible PPA repository
- name: 'ansible-noble'
  uris: 'https://ppa.launchpadcontent.net/ansible/ansible/ubuntu'
  suites: 'noble'
  components: 'main'
  signed_by: '/etc/apt/keyrings/ansible-noble.asc'

  # Third-party repo with architecture constraint
- name: 'virtualbox'
  uris: 'https://download.virtualbox.org/virtualbox/debian/'
  suites: 'bookworm'
  components: 'contrib'
  architectures: ['amd64']
  signed_by: '/etc/apt/keyrings/oracle_vbox_2016.asc'

  # Deprecated repository set to absent
- name: 'disco-security'
  state: 'absent'

lp_repos_keys:
  # Fetch key from Ubuntu keyserver over HTTPS
- url: 'https://keyserver.ubuntu.com/pks/lookup?op=get&search=0x909582fb991dbdbb59bff53eb6b8a03edce0e38e'
  dest: '/etc/apt/keyrings/ansible-noble.asc'
  mode: '0644'

  # Fetch key from project URL
- url: 'https://www.virtualbox.org/download/oracle_vbox_2016.asc'
  dest: '/etc/apt/keyrings/oracle_vbox_2016.asc'

  # Inline key block
- content: |
    -----BEGIN PGP PUBLIC KEY BLOCK-----
    ...
    -----END PGP PUBLIC KEY BLOCK-----
  dest: '/etc/apt/keyrings/custom-repo.asc'

  # Removing a deprecated key
- dest: '/etc/apt/keyrings/disco-security.asc'
  state: 'absent'
